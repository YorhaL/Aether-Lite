# Aether Lite environment template
# Copy this file to .env, replace every change-me value, and set ADMIN_PASSWORD.

# -----------------------------------------------------------------------------
# Application image and listener
# -----------------------------------------------------------------------------

# Stable releases use latest or a fixed version such as 1.2.3.
# Use edge only when intentionally tracking every push to the master branch.
APP_IMAGE=ghcr.io/yorhal/aether-lite:latest
APP_PORT=8084
TZ=Asia/Shanghai

# Public URL used when the application generates links for clients.
# Example: https://aether.example.com
# AETHER_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# Required secrets and initial administrator
# -----------------------------------------------------------------------------

# Run ./generate_keys.sh after copying this file to generate these two values.
JWT_SECRET_KEY=change-me
ENCRYPTION_KEY=change-me

# The administrator is created only when the database has no active admin.
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

API_KEY_PREFIX=sk

# -----------------------------------------------------------------------------
# PostgreSQL + Redis Compose deployment
# -----------------------------------------------------------------------------

# Use URL-safe values because Compose places these passwords in connection URLs.
DB_NAME=aether
DB_USER=postgres
DB_PASSWORD=change-me
DB_PORT=5432

REDIS_PASSWORD=change-me
REDIS_PORT=6379
REDIS_MAXCLIENTS=10000

# DB_HOST and REDIS_HOST are used by make dev when the gateway runs on the host.
DB_HOST=localhost
REDIS_HOST=localhost

# Optional PostgreSQL container tuning. Defaults target a modest dedicated host.
# POSTGRES_SHARED_BUFFERS=1GB
# POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
# POSTGRES_SHM_SIZE=512mb
# POSTGRES_WORK_MEM=16MB
# POSTGRES_MAINTENANCE_WORK_MEM=256MB

# -----------------------------------------------------------------------------
# HTTP, logging, and browser access
# -----------------------------------------------------------------------------

RUST_LOG=aether_gateway=info
AETHER_LOG_FORMAT=pretty

# Trust forwarded client IP headers only from these proxy networks.
# AETHER_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128,172.16.0.0/12

# Cross-origin browser clients should list explicit origins when credentials are
# enabled. Example: https://console.example.com,https://admin.example.com
# CORS_ORIGINS=
# CORS_ALLOW_CREDENTIALS=false
# AUTH_REFRESH_COOKIE_SAMESITE=Lax
# AUTH_REFRESH_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Database preparation and capacity tuning
# -----------------------------------------------------------------------------

# Compose deployments apply pending migrations and backfills during startup.
AETHER_GATEWAY_AUTO_PREPARE_DATABASE=true

# PostgreSQL connection pool. When unset, the gateway derives a pool from CPU.
# AETHER_GATEWAY_DATA_POSTGRES_MIN_CONNECTIONS=12
# AETHER_GATEWAY_DATA_POSTGRES_MAX_CONNECTIONS=80

# Per-process request and buffering limits. Zero or unset payload limits mean
# unlimited; the shared buffer budget still bounds concurrent body buffering.
# AETHER_GATEWAY_MAX_IN_FLIGHT_REQUESTS=2048
# AETHER_GATEWAY_REQUEST_BODY_BUFFER_BUDGET_MB=256
# AETHER_GATEWAY_REQUEST_BODY_READ_TIMEOUT_MS=120000
# AETHER_MAX_REQUEST_BODY_MB=0
# AETHER_MAX_INTERNAL_BUFFERED_BODY_MB=0
# AETHER_MAX_REDACTED_SYNC_RESPONSE_BODY_MB=0
# AETHER_GATEWAY_SECURITY_CACHE_TTL_MS=1000
